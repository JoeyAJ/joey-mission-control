{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "epoch",
    "projectId",
    "baselineSha",
    "expectedRevision",
    "kind",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "epoch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "projectId": {
      "enum": [
        "NEXAEON",
        "WOOSONG_BUDDY",
        "NAMYOUNG_WEB3D",
        "JOEY_ASSET_SYSTEM"
      ]
    },
    "baselineSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "proposal",
        "result",
        "decision"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mc:private-continuity-operation:v1",
  "title": "Offline design: bounded MC operation, not an applied cloud grant",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "proposal"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposalId",
              "contextHash",
              "acceptanceHash",
              "expiresAt"
            ],
            "properties": {
              "proposalId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "contextHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "acceptanceHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "expiresAt": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposalId",
              "resultHash",
              "evidenceHashes",
              "qualification"
            ],
            "properties": {
              "proposalId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "resultHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidenceHashes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "qualification": {
                "enum": [
                  "SUBMITTER_ATTESTED",
                  "OWNER_IMPORTED_UNVERIFIED"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposalId",
              "resultHash",
              "decision"
            ],
            "properties": {
              "proposalId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "resultHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "decision": {
                "enum": [
                  "ACCEPT",
                  "REJECT"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
