        "string",
        "null"
      ]
    },
    "currentModel": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastModel": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastCompletedAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastCompletedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "nextAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "handoffRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRepo": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "baselineSha": {
      "type": [
        "string",
        "null"
      ]
    },
    "productionUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "localWorkspace": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastSyncedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "const": "0.3"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "missionStatus": {
      "enum": [
        "Active",
        "Not recorded",
        "Awaiting sync",
        "Awaiting Joey approval",
        "Blocked",
        "Completed"
      ]
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "approvalStatus": {
      "enum": [
        "NO_APPROVAL_REQUIRED",
        "AWAITING_JOEY_APPROVAL",
        "APPROVED",
        "REJECTED",
        "BLOCKED"
      ]
    },
    "stateSource": {
      "enum": [
        "verified_release_snapshot",
        "canonical_projection",
        "local_mission_overlay"
      ]
    },
    "fields": {
      "type": "object"
    }
