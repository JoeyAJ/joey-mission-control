{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "currentMission",
    "currentAgent",
    "lastAgent",
    "currentModel",
    "lastModel",
    "lastCompletedAction",
    "lastCompletedAt",
    "nextAction",
    "blocker",
