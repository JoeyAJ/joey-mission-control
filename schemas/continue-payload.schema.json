{
  "$id": "continue-payload.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "entityId", "generatedAt", "lastAI", "lastCompleted",
    "currentTask", "blocker", "nextAction", "latestCommit", "recommendedWorkspace",
    "handoffContext", "sourceFingerprints", "sourceFingerprintDigest", "approvalGates",
    "conflicts", "freshness", "canContinue", "hermesPrompt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "entityId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "lastAI": {"type": "string"},
    "lastCompleted": {"type": "string"},
    "currentTask": {"type": "string"},
    "blocker": {"type": "string"},
    "nextAction": {"type": "string"},
    "latestCommit": {"type": "string"},
    "recommendedWorkspace": {"type": "string"},
    "handoffContext": {"type": "string"},
    "sourceFingerprints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "fingerprint"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "sourceFingerprintDigest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "approvalGates": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitObservedAt", "fingerprintsCurrent"],
      "properties": {
        "gitObservedAt": {"type": ["string", "null"]},
        "fingerprintsCurrent": {"type": "boolean"}
      }
    },
    "canContinue": {"type": "boolean"},
    "hermesPrompt": {"type": ["string", "null"]}
  }
}
